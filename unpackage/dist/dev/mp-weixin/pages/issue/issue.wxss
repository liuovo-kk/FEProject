/* 文章场景相关 */
.issue-container.data-v-065b927f {
  min-height: 100vh;
  background-color: #f8f9fa;
  padding: 20rpx 20rpx 140rpx;
  /* 调整padding，底部留出按钮位置 */
  box-sizing: border-box;
}

/* 上传区域样式 */
.upload-section.data-v-065b927f {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 0;
  /* 移除顶部margin */
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.image-preview.data-v-065b927f {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.preview-item.data-v-065b927f {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}
.preview-image.data-v-065b927f {
  width: 100%;
  height: 100%;
}
.delete-btn.data-v-065b927f {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24rpx;
  z-index: 2;
}
.upload-btn.data-v-065b927f {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #dcdfe6;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #fafafa;
  color: #c0c4cc;
  transition: all 0.3s;
}
.upload-btn.data-v-065b927f:active {
  background-color: #f0f0f0;
  transform: scale(0.98);
}
.upload-icon.data-v-065b927f {
  font-size: 60rpx;
  font-weight: 300;
  margin-bottom: 10rpx;
}
.upload-text.data-v-065b927f {
  font-size: 28rpx;
  color: #606266;
}

/* 表单区域样式 */
.form-section.data-v-065b927f {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-top: 20rpx;
  padding: 0 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.input-item.data-v-065b927f {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}
.input-item.data-v-065b927f:last-child {
  border-bottom: none;
}
.input-label.data-v-065b927f {
  font-size: 32rpx;
  color: #303133;
  font-weight: 500;
  margin-bottom: 20rpx;
}
.input-field.data-v-065b927f,
.textarea-field.data-v-065b927f {
  width: 100%;
  font-size: 28rpx;
  color: #303133;
  background-color: transparent;
  border: none;
  outline: none;
}
.textarea-field.data-v-065b927f {
  min-height: 200rpx;
  line-height: 1.5;
  padding-right: 100rpx;
}
.placeholder.data-v-065b927f {
  color: #c0c4cc;
  font-size: 28rpx;
}
.char-count.data-v-065b927f {
  position: absolute;
  right: 0;
  bottom: 30rpx;
  font-size: 24rpx;
  color: #909399;
}

/* 标签选择样式 */
.tag-item.data-v-065b927f {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
}
.tag-select.data-v-065b927f {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  color: #606266;
  font-size: 28rpx;
}
.selected-tags.data-v-065b927f {
  color: #303133;
  margin-right: 20rpx;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.arrow-icon.data-v-065b927f {
  color: #c0c4cc;
  font-size: 32rpx;
  font-weight: 300;
  transform: scaleY(1.5);
}

/* 发布按钮样式 */
.publish-btn-container.data-v-065b927f {
  position: fixed;
  bottom: 40rpx;
  /* 固定在底部，距离底部40rpx */
  left: 40rpx;
  right: 40rpx;
  z-index: 100;
}
.publish-btn.data-v-065b927f {
  width: 100%;
  height: 80rpx;
  background: #5F371E;
  color: #ffffff;
  border: none;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}
.publish-btn.data-v-065b927f:active {
  opacity: 0.9;
  transform: scale(0.98);
}
.publish-btn.disabled.data-v-065b927f {
  background: #5F371E;
  color: #ffffff;
}
.publish-btn.disabled.data-v-065b927f:active {
  opacity: 1;
  transform: none;
}