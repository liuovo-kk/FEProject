.modify-password-container.data-v-a1423707 {
  min-height: 100vh;
  background-color: #FAF5F0;
  /* 浅米色背景 */
  padding: 60rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 猫咪头像样式 */
.avatar-section.data-v-a1423707 {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 60rpx;
}
.cat-avatar.data-v-a1423707 {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  background-color: #FFFFFF;
}

/* 表单区域样式 */
.form-section.data-v-a1423707 {
  width: 80%;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 40rpx;
}
.input-item.data-v-a1423707 {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #E8DCCF;
  padding: 30rpx 0;
  position: relative;
}
.input-item.data-v-a1423707:last-child {
  border-bottom: none;
}
.password-input.data-v-a1423707 {
  flex: 1;
  height: 40rpx;
  font-size: 32rpx;
  color: #333333;
  padding-right: 20rpx;
}
.placeholder.data-v-a1423707 {
  font-size: 32rpx;
  color: #999999;
}
.eye-icon.data-v-a1423707 {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.3s;
}
.eye-icon.data-v-a1423707:active {
  background-color: rgba(0, 0, 0, 0.05);
}
.eye-text.data-v-a1423707 {
  font-size: 36rpx;
  line-height: 1;
}

/* 忘记密码按钮 */
.forgot-password.data-v-a1423707 {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding: 20rpx 0;
}
.forgot-text.data-v-a1423707 {
  font-size: 28rpx;
  color: #9E7961;
  /* 棕色 */
  font-weight: 500;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  transition: all 0.3s;
}
.forgot-text.data-v-a1423707:active {
  background-color: rgba(158, 121, 97, 0.1);
}

/* 修改按钮 */
.button-section.data-v-a1423707 {
  width: 90%;
  padding: 0 20rpx;
}
.modify-button.data-v-a1423707 {
  width: 100%;
  height: 90rpx;
  background-color: #9E7961;
  /* 棕色 */
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  box-shadow: 0 4rpx 12rpx rgba(158, 121, 97, 0.3);
}
.modify-button.disabled.data-v-a1423707 {
  background-color: #D4C7BC;
  box-shadow: none;
}
.modify-button.data-v-a1423707:active:not(.disabled) {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(158, 121, 97, 0.3);
}
.button-text.data-v-a1423707 {
  font-size: 34rpx;
  color: white;
  font-weight: 500;
  letter-spacing: 2rpx;
}