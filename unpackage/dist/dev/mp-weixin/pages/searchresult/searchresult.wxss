/* 文章场景相关 */
.search-result-page.data-v-b6187c50 {
  width: 100%;
  min-height: 100vh;
  background-color: #f8f8f8;
  display: flex;
  flex-direction: column;
}

/* 搜索栏 - 移除导航栏，搜索栏直接作为顶部 */
.search-header.data-v-b6187c50 {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-bottom: 2rpx solid #f0f0f0;
  height: 100rpx;
  box-sizing: border-box;
}

/* 返回按钮 */
.back-btn.data-v-b6187c50 {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 60rpx;
  margin-right: 20rpx;
}
.back-arrow.data-v-b6187c50 {
  font-size: 40rpx;
  color: #333;
}

/* 搜索框 */
.search-box.data-v-b6187c50 {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  padding: 0 20rpx;
  margin-right: 20rpx;
  height: 70rpx;
}
.search-input.data-v-b6187c50 {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 100%;
  background-color: transparent;
}
.clear-icon.data-v-b6187c50 {
  padding: 8rpx;
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 搜索按钮 */
.search-btn.data-v-b6187c50 {
  font-size: 30rpx;
  color: #5F371E;
  font-weight: 500;
  padding: 0 20rpx;
  height: 70rpx;
  line-height: 70rpx;
  white-space: nowrap;
}

/* 占位符样式 */
.placeholder-style.data-v-b6187c50 {
  color: #999;
  font-size: 28rpx;
}
.filter-item.data-v-b6187c50 {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 15rpx 0;
  border-radius: 8rpx;
  background-color: #f5f5f5;
}
.filter-item.active.data-v-b6187c50 {
  background-color: #5F371E;
  color: #fff;
}

/* 排序标签 */
.sort-tabs.data-v-b6187c50 {
  display: flex;
  padding: 5rpx 30rpx;
  background-color: #fff;
  border-bottom: 2rpx solid #f0f0f0;
}
.sort-item.data-v-b6187c50 {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 15rpx 0;
  position: relative;
}
.sort-item.active.data-v-b6187c50 {
  color: #333;
  font-weight: 600;
}
.sort-item.active.data-v-b6187c50::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #5F371E;
  border-radius: 2rpx;
}

/* 内容区域 */
.content-scroll.data-v-b6187c50 {
  flex: 1;
  background-color: #f8f8f8;
  padding: 20rpx 15rpx;
  box-sizing: border-box;
}
.content-grid.data-v-b6187c50 {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  width: 100%;
}

/* 卡片样式 */
.content-card.data-v-b6187c50 {
  width: calc(50% - 7.5rpx);
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.card-image.data-v-b6187c50 {
  width: 100%;
  height: 320rpx;
  position: relative;
  overflow: hidden;
  background-color: #f0f0f0;
}
.image-content.data-v-b6187c50 {
  width: 100%;
  height: 100%;
  display: block;
}
.card-content.data-v-b6187c50 {
  padding: 20rpx 15rpx;
}
.card-title.data-v-b6187c50 {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  margin-bottom: 15rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  min-height: 80rpx;
}

/* 点赞信息 */
.like-info.data-v-b6187c50 {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}
.heart-icon.data-v-b6187c50 {
  font-size: 24rpx;
  line-height: 1;
  color: #ff4757;
}
.like-count.data-v-b6187c50 {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
  line-height: 1;
}