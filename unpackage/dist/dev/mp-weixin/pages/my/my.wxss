.my-container.data-v-2f1ef635 {
  min-height: 100vh;
  background-color: #f5f5f7;
}

/* 用户信息区域样式 - 修改为左右布局 */
.user-info-section.data-v-2f1ef635 {
  background-color: #ffffff;
  padding: 40rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}
.user-left.data-v-2f1ef635 {
  display: flex;
  align-items: center;
  flex: 1;
}
.avatar-section.data-v-2f1ef635 {
  width: 120rpx;
  height: 120rpx;
  margin-right: 30rpx;
}
.avatar.data-v-2f1ef635 {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 2rpx solid #f0f0f0;
}
.user-details.data-v-2f1ef635 {
  flex: 1;
}
.username.data-v-2f1ef635 {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}
.major.data-v-2f1ef635 {
  font-size: 28rpx;
  color: #666666;
}

/* 功能按钮区域样式 - 修改为垂直排列 */
.action-buttons.data-v-2f1ef635 {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 130rpx;
}
.button-item.data-v-2f1ef635 {
  width: 100%;
  height: 60rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s;
}
.button-item.data-v-2f1ef635:active {
  opacity: 0.8;
}
.modify-password.data-v-2f1ef635 {
  background-color: #5f371e;
  color: #fff;
}
.logout.data-v-2f1ef635 {
  background-color: #5f371e;
  color: white;
}
.button-text.data-v-2f1ef635 {
  font-size: 24rpx;
  font-weight: 500;
}

/* 选项卡样式 - 修改为棕色 */
.tab-section.data-v-2f1ef635 {
  display: flex;
  background-color: #ffffff;
}
.tab-item.data-v-2f1ef635 {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 32rpx;
  color: #666666;
  position: relative;
  transition: all 0.3s;
  border-radius: 8rpx 8rpx 0 0;
}
.tab-item.active.data-v-2f1ef635 {
  color: #ffffff;
  /* 棕色 */
  font-weight: 500;
  background-color: #5F371E;
}
.tab-item.active.data-v-2f1ef635::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 6rpx;
  /* 棕色下划线 */
  border-radius: 3rpx 3rpx 0 0;
}
.tab-item.data-v-2f1ef635:not(.active) {
  background-color: #f5f5f5;
  color: #999;
}

/* 内容列表区域样式 - 修改为双列流式布局 */
.content-list.data-v-2f1ef635 {
  height: calc(100vh - 320rpx);
  background-color: #f5f5f7;
}
.content-section.data-v-2f1ef635 {
  padding: 20rpx 15rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.content-item.data-v-2f1ef635 {
  background-color: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
}
.content-image-container.data-v-2f1ef635 {
  width: 100%;
  height: 320rpx;
  overflow: hidden;
}
.content-image.data-v-2f1ef635 {
  width: 100%;
  height: 100%;
  display: block;
}
.content-desc.data-v-2f1ef635 {
  padding: 20rpx 20rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.4;
  min-height: 80rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 空状态样式 */
.empty-state.data-v-2f1ef635 {
  padding: 100rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  background-color: white;
  border-radius: 16rpx;
  min-height: 200rpx;
  width: 100%;
}
.empty-text.data-v-2f1ef635 {
  font-size: 32rpx;
  color: #999999;
  font-weight: 400;
}