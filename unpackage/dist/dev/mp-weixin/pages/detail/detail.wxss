
page.data-v-eca06f3c {
		background-color: #f8f8f8;
}
.container.data-v-eca06f3c {
		display: flex;
		flex-direction: column;
		height: 100vh;
		width: 100%;
}

	/* 头部样式 */
.header.data-v-eca06f3c {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 60px;
		padding: 0 15px;
		background-color: #f8f8f8;
		z-index: 100;
		display: flex;
		align-items: center;
}
.back-icon.data-v-eca06f3c {
		font-size: 24px;
		color: #333;
		width: 30px;
}
.user-info.data-v-eca06f3c {
		flex: 1;
		display: flex;
		align-items: center;
		/* margin-left: 40px; */
}
.avatar.data-v-eca06f3c {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		margin-right: 8px;
}
.username.data-v-eca06f3c {
		font-size: 16px;
		color: black;
}

	/* 修改：页面内容区域 */
.page-content.data-v-eca06f3c {
		flex: 1;
		overflow-y: auto;
		padding-bottom: 50px;
		/* 为底部操作栏留出空间 */
}

	/* 修改：swiper容器样式 */
.swiper-container.data-v-eca06f3c {
		background-color: #f8f8f8;
		margin-top: 44px;
		/* 为fixed header留出空间 */
}
.swiper.data-v-eca06f3c {
		width: 100%;
		transition: height 0.3s ease;
		/* 添加过渡效果 */
}
.post-image.data-v-eca06f3c {
		width: 100%;
		display: block;
		transition: opacity 0.3s ease;
		/* 图片加载淡入效果 */
}

	/* 内容区域样式 */
.content.data-v-eca06f3c {
		padding: 15px;
		/* background-color: #fff; */
}
.title.data-v-eca06f3c {
		font-size: 18px;
		font-weight: bold;
		color: #333;
		margin-bottom: 8px;
		display: block;
}
.description.data-v-eca06f3c {
		font-size: 15px;
		color: black;
		line-height: 1.7;
		display: block;
}

	/* 底部互动区域样式 */
.footer.data-v-eca06f3c {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		padding-right: 15px;
		position: relative;
}

	/* 在底部互动区下方添加分割线 */
.footer.data-v-eca06f3c::after {
		content: '';
		position: absolute;
		bottom: -5px;
		left: 15px;
		right: 15px;
		height: 1rpx;
		background-color: #eee;
}
.dislike-btn.data-v-eca06f3c {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 10px 0;
		border-bottom: 1rpx solid #eee;
}
.dislike-icon.data-v-eca06f3c {
		width: 20px;
		height: 20px;
		margin-right: 5px;
}
.action-icon-img.data-v-eca06f3c {
		width: 20px;
		height: 20px;
		margin-right: 4px;
}
.dislike-text.data-v-eca06f3c {
		font-size: 14px;
		color: #999;
}
.comments-section.data-v-eca06f3c {
		flex: 1;
		overflow-y: auto;
		padding: 10px 10px;
}
.comment-item.data-v-eca06f3c {
		display: flex;
		align-items: flex-start;
		margin-bottom: 15px;
		padding: 5px;
		position: relative;
		/* 为伪元素定位做准备 */
}

	/* 在每条评论下方添加分割线（最后一条评论不显示） */
.comment-item.data-v-eca06f3c:not(:last-child)::after {
		content: '';
		position: absolute;
		bottom: -5px;
		/* 调整位置，在评论项外部 */
		left: 46px;
		/* 从头像右侧开始 */
		right: 0;
		height: 1rpx;
		background-color: #eee;
}
.comment-avatar.data-v-eca06f3c {
		width: 38px;
		height: 38px;
		border-radius: 50%;
		margin-right: 10px;
}

	/* 右侧内容区：竖向排列 */
.comment-right.data-v-eca06f3c {
		flex: 1;
		display: flex;
		flex-direction: column;
}
.comment-username.data-v-eca06f3c {
		font-size: 14px;
		color: #666;
		/* font-weight: bold; */
}

	/* 评论内容 */
.comment-body.data-v-eca06f3c {
		/* margin-bottom: 6px; */
}
.comment-text.data-v-eca06f3c {
		font-size: 14px;
		color: black;
		margin-top: 3px;
}

	/* 操作按钮区：横向排列 */
.comment-actions.data-v-eca06f3c {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 20px;
}
.reply-btn.data-v-eca06f3c {
		padding: 0 10px;
		color: #999;
		font-size: 12px;
}
.like-dislike-area.data-v-eca06f3c {
		display: flex;
		align-items: center;
}
.like-btn.data-v-eca06f3c,
	.dislike-btn.data-v-eca06f3c {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0px 4px;
		margin-left: 8px;
		cursor: pointer;
}
.like-btn.liked.data-v-eca06f3c {
		color: red;
}
.dislike-btn.disliked.data-v-eca06f3c {
		color: #999;
}
.like-count.data-v-eca06f3c {
		font-size: 12px;
		margin-left: 2px;
}

	/* 底部操作栏 */
.bottom-bar.data-v-eca06f3c {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		height: 60px;
		background-color: #fff;
		display: flex;
		align-items: center;
		border-top: 1rpx solid #eee;
		padding: 0 15px;
		z-index: 100;
}
.input-container.data-v-eca06f3c {
		flex: 1;
		display: flex;
		align-items: center;
		background-color: #f5f5f5;
		padding: 5px 10px;
		border-radius: 20px;
		margin-right: 10px;
}
.input-icon.data-v-eca06f3c {
		color: #999;
		font-size: 16px;
		margin-right: 5px;
}
.comment-input.data-v-eca06f3c {
		flex: 1;
		font-size: 14px;
		color: #333;
}
.action-icons.data-v-eca06f3c {
		display: flex;
		align-items: center;
}
.like-btn.data-v-eca06f3c,
	.comment-btn.data-v-eca06f3c {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin: 0 15px;
}
.like-icon.data-v-eca06f3c,
	.comment-icon.data-v-eca06f3c {
		font-size: 20px;
		margin-bottom: 3px;
}
.like-count.data-v-eca06f3c,
	.comment-count.data-v-eca06f3c {
		font-size: 12px;
		color: #999;
}
.bottom-icon-img.data-v-eca06f3c {
		width: 30px;
		height: 30px;
		margin-right: 4px;
}
